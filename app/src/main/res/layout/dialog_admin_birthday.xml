<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_glass_dark"
    android:elevation="16dp"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_bday_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="Thông báo đặc biệt"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_bday_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="3dp"
        android:text="Hôm nay là sinh nhật của admin Mr. Wind. Hãy chúc mừng anh ấy nhé"
        android:textColor="#F2FFFFFF"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_bday_ok"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:elevation="6dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Đồng ý"
        android:textColor="#111827"
        android:textSize="13sp"
        android:textStyle="bold"
        app:backgroundTint="#D0BCFF"
        app:cornerRadius="12dp" />
</LinearLayout>
